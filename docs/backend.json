
{
  "entities": {
    "Politician": {
      "title": "Politician",
      "description": "A public official being tracked for accountability.",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "aliasNames": { "type": "array", "items": { "type": "string" } },
        "dateOfBirth": { "type": "string", "format": "date" },
        "profileImageUrl": { "type": "string" },
        "bio": { "type": "string" },
        "primaryParty": { "type": "string" },
        "accountabilityScore": { "type": "number" },
        "totalForfeiture": { "type": "number" },
        "sourceOrigin": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "partyHistory": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "party": { "type": "string" },
              "years": { "type": "string" }
            }
          }
        }
      },
      "required": ["fullName", "primaryParty"]
    },
    "CaseRecord": {
      "title": "Case Record",
      "description": "A legal case involving a politician.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["alleged", "under_investigation", "charged", "convicted", "dismissed"] },
        "amountInvolved": { "type": "number" },
        "currency": { "type": "string" },
        "caseStartDate": { "type": "string", "format": "date" },
        "caseEndDate": { "type": "string", "format": "date" }
      },
      "required": ["title", "status"]
    },
    "OfficeHeld": {
      "title": "Office Held",
      "description": "A public office occupied by the politician.",
      "type": "object",
      "properties": {
        "officeTitle": { "type": "string" },
        "state": { "type": "string" },
        "constituency": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" }
      },
      "required": ["officeTitle", "startDate"]
    },
    "Source": {
      "title": "Source",
      "description": "Verifiable source for a case or record.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "publisher": { "type": "string" },
        "publicationDate": { "type": "string", "format": "date" },
        "credibilityRating": { "type": "number" }
      },
      "required": ["title", "url", "publisher"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/politicians/{politicianId}": {
      "schema": "#/backend/entities/Politician",
      "description": "Main politician records."
    },
    "/politicians/{politicianId}/cases/{caseId}": {
      "schema": "#/backend/entities/CaseRecord",
      "description": "Legal cases for a politician."
    },
    "/politicians/{politicianId}/offices/{officeId}": {
      "schema": "#/backend/entities/OfficeHeld",
      "description": "Offices held by a politician."
    },
    "/politicians/{politicianId}/cases/{caseId}/sources/{sourceId}": {
      "schema": "#/backend/entities/Source",
      "description": "Sources attributed to a specific case."
    },
    "/politicians/{politicianId}/detentions/{detentionId}": {
      "schema": { "type": "object" },
      "description": "Records of detention periods."
    }
  }
}
